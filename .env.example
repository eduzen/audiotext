# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=

# Smallest Whisper model, suitable for a CPU-only VM with 4 GB RAM.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=2

# Telegram's hosted Bot API supports downloads up to 20 MB.
MAX_UPLOAD_MB=20

# Maximum accepted transcription requests per Telegram user in a rolling minute.
TRANSCRIPTIONS_PER_MINUTE=3
# Optional: restrict transcription to these comma-separated Telegram user IDs.
# ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Optional; defaults to the system temporary directory.
# TEMP_DIR=/tmp/audiotext

# SQLite transcript history (store on a persistent, private volume in production).
# DATABASE_PATH=data/audiotext.sqlite3

# Python logging level.
LOG_LEVEL=INFO

